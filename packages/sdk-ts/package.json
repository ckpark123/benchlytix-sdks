{
  "name": "@benchlytixai/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the BenchLytix Machine API — agent trust scores, leaderboards, and verification.",
  "keywords": [
    "benchlytix",
    "ai-agents",
    "leaderboard",
    "verification",
    "agent-trust",
    "sdk"
  ],
  "license": "MIT",
  "author": "BenchLytix <support@benchlytix.com>",
  "homepage": "https://benchlytix.com/for/agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckpark123/benchlytix-sdks.git",
    "directory": "packages/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/ckpark123/benchlytix-sdks/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
